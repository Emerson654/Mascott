# Mascott web — environment variables. Copy to .env.local (never commit real values).
# Every variable is optional: without them the site still works (fallback generator, canned chat,
# checkout -> /pricing#pilot, leads logged to the server console).

# --- Site ---
# Public base URL, used for Stripe success/cancel URLs (otherwise the request origin is used).
NEXT_PUBLIC_SITE_URL=https://mascotte.io

# --- AI (mascot generator + chat demo). Gemini first, then xAI, then deterministic fallback ---
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override (default gemini-flash-lite-latest: fast, free tier).
GEMINI_MODEL=
# Key: https://console.x.ai (free credits on sign-up)
XAI_API_KEY=
# Optional model override (default grok-3-mini).
XAI_MODEL=

# --- Stripe (see docs/stripe-setup.md). Server-side secret: dashboard.stripe.com/apikeys ---
STRIPE_SECRET_KEY=
# Price ids (price_...) per plan and billing period: STRIPE_PRICE_<PLANID>_<MONTHLY|YEARLY>
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_YEARLY=
STRIPE_PRICE_SCALE_MONTHLY=
STRIPE_PRICE_SCALE_YEARLY=
# Launch coupon id, applied to monthly checkouts only while the launch offer is active (src/lib/pricing.ts).
STRIPE_LAUNCH_COUPON=
# Note: Checkout enables automatic tax + tax id collection; activate Stripe Tax in the dashboard first.
# Webhook signing secret (whsec_...): Dashboard > Developers > Webhooks, endpoint /api/stripe/webhook,
# event checkout.session.completed. Local: `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
STRIPE_WEBHOOK_SECRET=
# Fallback when no secret key: Stripe Payment Links (public URLs) NEXT_PUBLIC_STRIPE_LINK_<PLANID>_<MONTHLY|YEARLY>
NEXT_PUBLIC_STRIPE_LINK_STARTER_MONTHLY=
NEXT_PUBLIC_STRIPE_LINK_STARTER_YEARLY=
NEXT_PUBLIC_STRIPE_LINK_GROWTH_MONTHLY=
NEXT_PUBLIC_STRIPE_LINK_GROWTH_YEARLY=
NEXT_PUBLIC_STRIPE_LINK_SCALE_MONTHLY=
NEXT_PUBLIC_STRIPE_LINK_SCALE_YEARLY=

# --- Lead & sale notifications (/api/lead and the Stripe webhook) ---
# Any URL accepting a JSON POST: Slack incoming webhook, Make, Zapier...
LEAD_WEBHOOK_URL=
# Email via Resend (free tier): https://resend.com/api-keys
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
# Sender, must be on a domain verified in Resend (default: onboarding@resend.dev, test only).
LEAD_FROM_EMAIL=
